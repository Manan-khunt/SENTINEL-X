# SENTINEL-X backend configuration.
# Copy to .env and fill in:  cp .env.example .env
# Never commit .env or real secrets (see .gitignore).

# SQLite database URL (WAL mode). No Postgres/Redis needed.
DATABASE_URL=sqlite:///./sentinelx.db
# JWT signing secret: REQUIRED, min 32 chars. Startup fails cleanly if shorter.
JWT_SECRET=change-me-in-production-min-32-chars
# Token lifetime in seconds.
JWT_EXPIRY=3600
# LLM provider: mock | replay | anthropic (mock = deterministic demo, always works).
LLM_PROVIDER=mock
LLM_MODEL=mock-structured-v1
LLM_TEMPERATURE=0
# Only needed when LLM_PROVIDER=anthropic. Startup fails if missing then.
ANTHROPIC_API_KEY=
# CORS origin for the Vite frontend.
FRONTEND_ORIGIN=http://localhost:5173
# development | production. When production, DEMO_MODE must be false.
APP_ENV=development
DEMO_MODE=true
# SSE ticket lifetime in seconds.
SSE_TICKET_TTL=120
# Max tool-gateway actions recorded per incident before escalation.
RATE_LIMIT_PER_INCIDENT=10
# Max agent replans before FAILED.
MAX_REPLANS=10
# Consecutive no-progress cycles before ESCALATED.
NO_PROGRESS_LIMIT=3
# Tamper-evident audit anchor file (external copy recommended).
ANCHOR_PATH=./audit_anchors.jsonl
# Write an anchor every N audit entries (plus every closing event).
AUDIT_ANCHOR_EVERY=10
