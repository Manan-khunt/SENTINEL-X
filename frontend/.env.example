# Frontend -> backend connection.
# Local dev: keep the default. Vite proxies /api to http://localhost:8000
# (see vite.config.ts). Backend CORS allows http://localhost:5173.
VITE_API_BASE_URL=/api

# Production (served behind the same host as the API, e.g. nginx):
# VITE_API_BASE_URL=/api
# Direct-API deployments:
# VITE_API_BASE_URL=http://localhost:8000/api
